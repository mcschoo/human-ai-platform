# Generate with: ./scripts/generate-api-key.sh
# PowerShell:    ./scripts/generate-api-key.ps1
VLLM_API_KEY=replace-with-a-random-secret

# Optional for gated models or higher Hugging Face rate limits.
HF_TOKEN=

# Available profiles live in config/models/.
MODEL_PROFILE=qwen3.5-9b-bf16

# Safe local default. For remote TLS, see README.md before changing this.
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_PORT=8080
CADDY_SITE_ADDRESS=:8080
ADMIN_PORT=2019

# Operator UI is loopback-only. Replace both secrets before use.
CONTROL_PLANE_PORT=8090
CONTROL_PLANE_OPERATOR_PASSWORD=replace-with-a-random-secret
CONTROL_PLANE_COOKIE_SECRET=replace-with-a-different-random-secret
CONTROL_PLANE_MODEL=qwen3.5-9b

# Required only with compose.tls.yaml.
TLS_DOMAIN=
